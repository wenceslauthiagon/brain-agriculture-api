datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Crop {
  SOYBEAN
  CORN
  C
  OTTON
  COFFEE
  SUGARCANE
}

enum Status {
  ACTIVE
  INACTIVE
}

model Producer {
  id        String   @id @default(uuid())
  document  String   @unique // Validar no backend se é CPF (11) ou CNPJ (14)
  name      String
  status    Status   @default(ACTIVE)
  farms     Farm[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("producers")
}

model Farm {
  id             String  @id @default(uuid())
  name           String
  city           String
  state          String  @db.VarChar(2) // Garante sigla de 2 caracteres ex: "SP"
  totalArea      Decimal @db.Decimal(10, 2) @map("total_area")
  arableArea     Decimal @db.Decimal(10, 2) @map("arable_area")
  vegetationArea Decimal @db.Decimal(10, 2) @map("vegetation_area")
  producerId     String  @map("producer_id")
  status         Status  @default(ACTIVE)

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  crops     FarmCrop[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  @@index([producerId])
  @@index([state])
  @@map("farms")
}

model FarmCrop {
  id       String    @id @default(uuid())
  crop     Crop
  harvest  String // Ex: "2023/2024" ou "2024"
  farmId   String    @map("farm_id")
  deletedAt DateTime? @map("deleted_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, crop, harvest])
  @@index([farmId])
  @@map("farm_crops")
}
